+-- Keep minute-by-minute mailbox and completion checks scoped to each recipient.
+-- The existing status/due index remains useful for due-message selection.
+CREATE INDEX steps_recipient_status_due ON steps(recipient_id,status,due_at,ordinal);
+CREATE INDEX attempts_status_created ON attempts(status,created_at);
+CREATE INDEX attempts_inbox_status ON attempts(inbox_id,status);
+CREATE INDEX manual_replies_inbox_status ON manual_replies(inbox_id,status);
+CREATE INDEX campaigns_status_mode ON campaigns(status,mode,is_test);
