new file mode 100644
index 0000000..5c1ddcc
--- /dev/null
+++ b/scripts/check-d1-query-plans.py
@@ -0,0 +1,64 @@
+"""Offline SQLite regression checks. No production access or email sending."""
+from pathlib import Path
+import re
+import sqlite3
+
+root = Path(__file__).resolve().parent.parent
+
+def mailbox_query(text):
+    return re.search(r'prepare\("(SELECT \* FROM inboxes WHERE token!=.*?LIMIT 1)"\)', text).group(1)
+
+def measure(db, query):
+    instructions = 0
+    def tick():
+        nonlocal instructions
+        instructions += 1
+        return 0
+    db.set_progress_handler(tick, 1)
+    rows = db.execute(query).fetchall()
+    db.set_progress_handler(None, 0)
+    return rows, instructions
+
+old_query = "SELECT * FROM inboxes WHERE token!='' AND EXISTS(SELECT 1 FROM recipients r JOIN steps s ON s.recipient_id=r.id WHERE r.inbox_id=inboxes.id AND s.status='sent') ORDER BY last_checked LIMIT 1"
+new = (root/'src/replies.ts').read_text()
+db = sqlite3.connect(':memory:')
+for file in sorted((root/'migrations').glob('*.sql')):
+    if file.name < '0011':
+        db.executescript(file.read_text())
+db.execute("INSERT INTO campaigns(id,name,client,mode,created_at) VALUES('c','Fixture','PostingMachine','live',0)")
+for n in range(10):
+    db.execute("INSERT INTO inboxes(id,email,client,token,created_at,last_checked) VALUES(?,?,'PostingMachine','fake',0,?)", (f'i{n}',f'sender{n}@example.com',n))
+for n in range(1500):
+    db.execute("INSERT INTO recipients(id,campaign_id,email,mode,inbox_id,unsubscribe_token,created_at) VALUES(?,'c',?,'live','i0',?,0)",(f'r{n}',f'p{n}@example.com',f'u{n}'))
+    db.execute("INSERT INTO steps(id,recipient_id,ordinal,subject,body,status) VALUES(?,?,0,'hello','fixture','sent')",(f's{n}',f'r{n}'))
+before, before_cost = measure(db, old_query)
+for file in sorted((root/'migrations').glob('0011*.sql')):
+    db.executescript(file.read_text())
+after, after_cost = measure(db, mailbox_query(new))
+assert before == after and after[0][0] == 'i0'
+assert after_cost < before_cost / 10, (before_cost, after_cost)
+print(f'Mailbox selection: {before_cost:,} -> {after_cost:,} SQLite VM instructions ({before_cost/after_cost:.1f}x less work).')
+plan = [row[3] for row in db.execute('EXPLAIN QUERY PLAN '+mailbox_query(new))]
+assert any('recipient_inbox' in row for row in plan), plan
+assert any('steps_recipient_status_due' in row for row in plan), plan
+# Empty mailboxes must still be skipped when the populated mailbox is disconnected.
+db.execute("UPDATE inboxes SET token='' WHERE id='i0'")
+assert db.execute(mailbox_query(new)).fetchall() == []
+# Completion must preserve the status of campaigns with pending, failed or uncertain work.
+source=(root/'src/queue.ts').read_text()
+completion=re.search(r'export async function completeCampaigns.*?prepare\(`(.*?)`\)', source).group(1)
+db.execute("UPDATE campaigns SET status='running'")
+db.execute(completion)
+assert db.execute("SELECT status FROM campaigns").fetchone()[0] == 'complete'
+for status in ['pending','inflight','uncertain','failed']:
+    db.execute("UPDATE campaigns SET status='running'")
+    db.execute("UPDATE steps SET status=? WHERE id='s0'", (status,))
+    db.execute(completion)
+    assert db.execute('SELECT status FROM campaigns').fetchone()[0] == 'running',status
+# Held recipients do not allow an unresolved failed/uncertain attempt to be hidden.
+db.execute("UPDATE recipients SET status='held' WHERE id='r0'")
+for status in ['failed','uncertain']:
+    db.execute("UPDATE steps SET status=? WHERE id='s0'",(status,))
+    db.execute(completion)
+    assert db.execute('SELECT status FROM campaigns').fetchone()[0] == 'running'
+print('Mailbox choice, index use, empty mailboxes and campaign completion checks passed.')
