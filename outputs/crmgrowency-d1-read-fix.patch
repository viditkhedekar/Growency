new file mode 100644
index 0000000..776c852
--- /dev/null
+++ b/tests/d1-reads.test.ts
@@ -0,0 +1,27 @@
+import { it, expect } from 'vitest';
+import { Miniflare, convertV4MiniflareOptions } from 'miniflare';
+import { readFileSync, readdirSync } from 'node:fs';
+import { syncReplyMailbox } from '../src/replies';
+import { runScheduled } from '../src/queue';
+import type { Env } from '../src/types';
+
+it('keeps an idle scheduler below the daily free read budget with imported campaigns',async()=>{
+ const mf=new Miniflare(convertV4MiniflareOptions({modules:true,script:'export default { fetch(){ return new Response("ok") } }',compatibilityDate:'2026-10-01',d1Databases:['DB']}));
+ try {
+ const db=await mf.getD1Database('DB');
+ await db.exec(readdirSync('migrations').sort().map(f=>readFileSync('migrations/'+f,'utf8')).join('\n').replace(/\n/g,' '));
+ await db.exec("INSERT INTO campaigns(id,name,client,mode,created_at) VALUES('c','Imported','PostingMachine','live',0);");
+ await db.exec("WITH RECURSIVE n(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<1500) INSERT INTO recipients(id,campaign_id,email,mode,unsubscribe_token,created_at) SELECT 'r'||x,'c','person'||x||'@example.com','live','u'||x,0 FROM n;");
+ await db.exec("INSERT INTO steps(id,recipient_id,ordinal,subject,body,due_at) SELECT id||'-0',id,0,'hello','body',0 FROM recipients;");
+ for(let n=0;n<10;n++)await db.prepare("INSERT INTO inboxes(id,email,client,token,created_at) VALUES(?,?,'PostingMachine','unused',0)").bind('i'+n,'sender'+n+'@example.com').run();
+ let reads=0;
+ const raw=Symbol('statement');
+ function statement(s:any):any {return new Proxy(s,{get(target,key){if(key===raw)return target;if(key==='bind')return (...args:any[])=>statement(target.bind(...args));if(key==='first')return async(column?:string)=>{const result=await target.all();reads+=result.meta.rows_read;const row=result.results[0];return row?(column?row[column]:row):null;};if(key==='all'||key==='run')return async(...args:any[])=>{const result=await target[key](...args);reads+=result.meta.rows_read;return result;};return Reflect.get(target,key);}});}
+ const measured=new Proxy(db,{get(target,key){if(key==='prepare')return (sql:string)=>statement(target.prepare(sql));if(key==='batch')return async(stmts:any[])=>{const result=await target.batch(stmts.map(s=>s[raw]));reads+=result.reduce((n:number,r:any)=>n+r.meta.rows_read,0);return result;};const value=Reflect.get(target,key);return typeof value==='function'?value.bind(target):value;}});
+ const env={DB:measured,ENABLE_LIVE_SENDING:'false'} as unknown as Env;
+ await syncReplyMailbox(env);
+ await runScheduled(env,Date.parse('2026-10-29T10:00:00Z'));
+ console.log('Idle scheduler rows read per minute:',reads,'daily projection:',reads*1440);
+ expect(reads).toBeLessThan(1000);
+ }finally{await mf.dispose();}
+},30000);
